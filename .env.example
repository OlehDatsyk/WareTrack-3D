# ---------------------------------------------------------------
# WareTrack 3D — environment configuration
# Copy to .env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------

# PostgreSQL connection string (local docker compose publishes Postgres on port 5433)
DATABASE_URL="postgresql://waretrack:waretrack_dev_password@localhost:5433/waretrack"

# Separate database used by the automated test suite (it is wiped on every run)
TEST_DATABASE_URL="postgresql://waretrack:waretrack_dev_password@localhost:5433/waretrack_test"

# Session lifetime in hours
SESSION_TTL_HOURS=12

# Set to "false" to hide the demo-account helper on the sign-in page
NEXT_PUBLIC_DEMO_MODE=true

# Password given to the seeded demo accounts (admin/manager/operator/viewer@waretrack.demo).
# Use a different, strong value for any shared or deployed environment.
SEED_DEMO_PASSWORD="WareTrack#2026"

# Set to "false" to skip demo data when a fresh deployment starts with an empty database
SEED_DEMO_DATA=true
